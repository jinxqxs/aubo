<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aubo_i5H">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find aubo_i5h_moveit1)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>
    <gazebo reference="afinger1_link">
        <mu1>20.0</mu1>
        <mu2>20.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="afinger2_link">
        <mu1>20.0</mu1>
        <mu2>20.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <!-- Import aubo_i5H urdf file -->
    <xacro:include filename="$(find aubo_description)/urdf/aubo_i5H.urdf" />
    
    <!-- Import control_xacro -->
    <xacro:include filename="aubo_i5H.ros2_control.xacro" />

    <xacro:aubo_i5H_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
